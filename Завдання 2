#include <iostream>
#include <queue>
using namespace std;

int main() {
    system("chcp 1251 > nul");

    queue<int> source;
    queue<int> result;

    for (int i = 1; i <= 200; i++) {
        source.push(i);
    }

    while (!source.empty()) {
        int x = source.front();
        source.pop();

        if (x % 4 == 0 && x % 6 == 0) {
            result.push(x);
        }
    }

    cout << "Числа, які діляться на 4 і на 6 одночасно:\n";
    while (!result.empty()) {
        cout << result.front() << " ";
        result.pop();
    }
    cout << endl;

    return 0;
}
