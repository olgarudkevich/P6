#include <iostream>
#include <queue>
using namespace std;

int main() {
    system("chcp 1251 > nul");

    queue<int> numbers;

    int values[20] = {15, 8, 23, 4, 15, 42, 10, 18, 5, 30, 2, 25, 15, 9, 12, 10, 50, 7, 3, 20};
    for (int i = 0; i < 20; i++) {
        numbers.push(values[i]);
    }

    int firstElement = numbers.front();
    int sum = 0;

    cout << "Елементи черги: ";

    while (!numbers.empty()) {
        int current = numbers.front();
        cout << current << " ";
        numbers.pop();

        if (current > firstElement) {
            sum += current;
        }
    }

    cout << "\n\nПерший елемент черги: " << firstElement << endl;
    cout << "Сума елементів, більших за перший (" << firstElement << "): " << sum << endl;

    return 0;
}
